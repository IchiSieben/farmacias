# Algolia search credentials, one pair per chain.
# These are the PUBLIC client-side search keys each chain ships in its own
# storefront JS bundle — not private credentials of this project. They are kept
# out of the repo anyway. Copy this file to .env and fill in the values.
INKAFARMA_ALGOLIA_APP_ID=
INKAFARMA_ALGOLIA_API_KEY=
MIFARMA_ALGOLIA_APP_ID=
MIFARMA_ALGOLIA_API_KEY=
# Optional host overrides (derived from the app id when empty):
INKAFARMA_ALGOLIA_HOST=
MIFARMA_ALGOLIA_HOST=

# --- Data lake (V2_PLAN F1) ---------------------------------------------------
# Carpeta del crudo. En producción, una carpeta de Google Drive para escritorio:
#   G:\Mi unidad\radar-precios\raw            (modo streaming; la letra varía)
#   C:\Users\<tu-usuario>\Mi unidad\radar-precios\raw   (modo mirror)
# Verifícala en el Explorador antes de escribirla. Vacío -> data/raw/ local.
# Si está definida y no existe (Drive sin montar), la corrida falla de inmediato.
RAW_DIR=
# Parquet (ofertas, eventos). Vacío -> data/processed/ local.
PROCESSED_DIR=

# --- Publicación (py -m pipeline.publish; manual, pide confirmación) -----------
# La tarea diaria NO publica: exporta a data/publicar/data.json (staging).
# Protocolo: ftps (default) | ftp | sftp (sftp requiere `py -m pip install paramiko`).
PUBLISH_PROTOCOL=ftps
PUBLISH_HOST=
PUBLISH_PORT=
PUBLISH_USER=
PUBLISH_PASS=
# Carpeta remota donde vive data.json (p.ej. domains/<dominio>/public_html/radar-precios)
PUBLISH_REMOTE_DIR=
# URL pública del data.json servido (contra qué se compara). Vacío -> ichisieben.dev.
PUBLISH_PUBLIC_URL=
