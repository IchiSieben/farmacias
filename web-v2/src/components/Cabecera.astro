---
import { textos, t, fecha, otroIdioma, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  snapshot: string;
}
const { idioma, snapshot } = Astro.props;
const dic = textos(idioma);
const otro = otroIdioma(idioma);
const hrefOtro = Astro.url.pathname.replace(`/${idioma}/`, `/${otro}/`);
---

<header class="border-b border-borde bg-superficie">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href={`${import.meta.env.BASE_URL}${idioma}/`} class="flex min-w-0 items-center gap-2.5">
      <img src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="28" height="28" class="size-7 shrink-0" />
      <span class="min-w-0">
        <span class="block text-base font-semibold leading-tight tracking-tight">{t(dic, 'sitio.nombre')}</span>
        <span class="block truncate text-xs text-suave">{t(dic, 'sitio.subtitulo')}</span>
      </span>
    </a>
    <p class="ml-auto hidden text-sm text-suave sm:block">
      {t(dic, 'cabecera.actualizado', { fecha: fecha(idioma, snapshot) })}
    </p>
    <a
      href={hrefOtro}
      hreflang={otro}
      lang={otro}
      data-idioma={otro}
      title={t(dic, 'cabecera.idioma.aria')}
      class="ml-auto rounded-md border border-borde px-2.5 py-1.5 text-sm font-medium hover:bg-superficie-2 sm:ml-0"
    >{t(dic, 'cabecera.idioma')}</a>
    <button
      type="button"
      id="tema"
      aria-label={t(dic, 'cabecera.tema.aria')}
      class="grid size-9 place-items-center rounded-md border border-borde hover:bg-superficie-2"
    >
      <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
  <p class="mx-auto max-w-6xl px-4 pb-2 text-xs text-suave sm:hidden">
    {t(dic, 'cabecera.actualizado', { fecha: fecha(idioma, snapshot) })}
  </p>
</header>

<script is:inline>
  document.getElementById('tema')?.addEventListener('click', function () {
    var oscuro = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro'); } catch (e) {}
  });
  document.querySelectorAll('[data-idioma]').forEach(function (a) {
    a.addEventListener('click', function () {
      try { localStorage.setItem('idioma', a.getAttribute('data-idioma')); } catch (e) {}
    });
  });
</script>
