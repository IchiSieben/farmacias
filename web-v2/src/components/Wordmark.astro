---
// Marca del Radar de Precios: aro de radar con un barrido y un punto (la "oferta" detectada,
// en el acento de ahorro) + el nombre. Todo vectorial, sin emoji. Hereda color del texto.
interface Props {
  altura?: number;
  soloMarca?: boolean;
  class?: string;
}
const { altura = 28, soloMarca = false, class: clase } = Astro.props;
const ancho = soloMarca ? altura : Math.round((altura * 196) / 32);
---

<svg
  class={clase}
  width={ancho}
  height={altura}
  viewBox={soloMarca ? '0 0 32 32' : '0 0 196 32'}
  role="img"
  aria-label="Radar de Precios"
  fill="none"
>
  <title>Radar de Precios</title>
  <circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="2"></circle>
  <path d="M16 9.5a6.5 6.5 0 0 1 6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  <path d="M16 16 25 7" stroke="rgb(var(--accent))" stroke-width="2" stroke-linecap="round"></path>
  <circle cx="10.5" cy="21" r="2.4" fill="rgb(var(--saving))"></circle>
  {!soloMarca && (
    <text
      x="40" y="22.5" fill="currentColor"
      font-family="'Space Grotesk Variable','Space Grotesk','Inter Variable',system-ui,sans-serif"
      font-size="19" font-weight="600" letter-spacing="-0.3"
      textLength="154" lengthAdjust="spacingAndGlyphs"
    >Radar de Precios</text>
  )}
</svg>
