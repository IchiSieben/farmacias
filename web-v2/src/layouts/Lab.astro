---
// Layout mínimo de las páginas de laboratorio. El ClientRouter (View Transitions) vive solo aquí:
// Base.astro y el resto del sitio no lo cargan.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  titulo: string;
}
const { idioma, titulo } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{titulo}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Mismo criterio de tema que Base.astro: elección guardada > sistema.
      (function () {
        var guardado = null;
        try { guardado = localStorage.getItem('tema'); } catch (e) {}
        var oscuro = guardado ? guardado === 'oscuro' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', oscuro);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-fondo text-texto">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-6">
      <slot />
    </main>
  </body>
</html>
