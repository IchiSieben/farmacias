---
// Layout del laboratorio de identidad (/lab/). No sustituye a Base.astro: carga los tokens
// propios, aplica el tema antes del primer pintado y trae la cabecera con el toggle.
import '../styles/tokens.css';
import '@fontsource-variable/inter'; // respaldo: ya instalado, sirve 'Inter Variable'
// PENDIENTE DE INSTALAR (no hay npm en el nodo del enjambre). En Windows:
//   npm i @fontsource-variable/space-grotesk @fontsource-variable/jetbrains-mono
// y descomentar estas dos líneas; tokens.css ya las nombra primero en --font-display / --font-mono.
// import '@fontsource-variable/space-grotesk';
// import '@fontsource-variable/jetbrains-mono';
import Wordmark from '../components/Wordmark.astro';
import { textos, t, otroIdioma, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  titulo: string;
}
const { idioma, titulo } = Astro.props;
const dic = textos(idioma);
const base = import.meta.env.BASE_URL;
const ruta = Astro.url.pathname;
const portadas = [
  { id: 'a', clave: 'lab.nav.a' },
  { id: 'b', clave: 'lab.nav.b' },
  { id: 'c', clave: 'lab.nav.c' },
] as const;
const otro = otroIdioma(idioma);
const hrefOtro = ruta.replace(`/${idioma}/`, `/${otro}/`);
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Radar de Precios · Lab</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Tema antes del primer render: elección guardada > preferencia del sistema > oscuro.
      (function () {
        var guardado = null;
        try { guardado = localStorage.getItem('theme'); } catch (e) {}
        var claro = guardado ? guardado === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.classList.toggle('light', claro);
      })();
    </script>
  </head>
  <body>
    <p class="aviso">{t(dic, 'lab.aviso')}</p>
    <header class="cab">
      <a class="marca" href={`${base}${idioma}/lab/portada-a/`} aria-label="Radar de Precios">
        <Wordmark altura={28} />
      </a>
      <nav class="nav" aria-label="Portadas">
        {portadas.map((p) => (
          <a href={`${base}${idioma}/lab/portada-${p.id}/`} aria-current={ruta.includes(`portada-${p.id}`) ? 'page' : undefined}>
            {t(dic, p.clave)}
          </a>
        ))}
      </nav>
      <div class="acciones">
        <a class="idioma" href={hrefOtro} hreflang={otro} lang={otro}>{otro.toUpperCase()}</a>
        <button type="button" id="tema" class="tema" aria-label={t(dic, 'lab.tema')}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </div>
    </header>
    <slot />
    <script is:inline>
      // Único JS del layout: alternar y recordar el tema.
      (function () {
        var b = document.getElementById('tema');
        if (!b) return;
        b.addEventListener('click', function () {
          var claro = document.documentElement.classList.toggle('light');
          try { localStorage.setItem('theme', claro ? 'light' : 'dark'); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .aviso {
    margin: 0;
    padding: var(--sp-1) var(--sp-4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgb(var(--muted));
    border-bottom: 1px solid rgb(var(--border));
    background: rgb(var(--surface));
  }
  .cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-6);
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--sp-4) var(--sp-4);
  }
  .marca { color: rgb(var(--fg)); display: inline-flex; text-decoration: none; }
  .nav { display: flex; gap: var(--sp-1); margin-inline: auto; flex-wrap: wrap; }
  .nav a {
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-full);
    color: rgb(var(--muted));
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .nav a:hover { color: rgb(var(--fg)); background: rgb(var(--surface)); }
  .nav a[aria-current='page'] { color: rgb(var(--fg)); background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--border)); }
  .acciones { display: flex; align-items: center; gap: var(--sp-2); }
  .idioma {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid rgb(var(--border));
    border-radius: var(--radius-full);
    color: rgb(var(--fg));
    text-decoration: none;
  }
  .tema {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid rgb(var(--border));
    background: rgb(var(--surface));
    color: rgb(var(--fg));
    cursor: pointer;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .tema:hover { transform: rotate(20deg); }

  /* Piezas compartidas por las tres portadas */
  .logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    padding: 0 6px;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
  }
  .logo img { display: block; object-fit: contain; }
  .logo-mono {
    display: inline-grid;
    flex: none;
    place-items: center;
    border-radius: var(--radius-sm);
    color: #fff;
    font-weight: var(--weight-bold);
    line-height: 1;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: 2px var(--sp-3);
    border-radius: var(--radius-full);
    background: rgb(var(--saving));
    color: rgb(var(--on-saving));
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
  .lab-main { max-width: 80rem; margin: 0 auto; padding: 0 var(--sp-4) var(--sp-24); }
</style>
