---
// Portada C · tablero denso: filas compactas, una columna de precio por cadena y sparkline
// (SVG inline) del precio más bajo de cada producto a lo largo de su historial.
import Lab from '../../../layouts/Lab.astro';
import { IDIOMAS, textos, t, soles, fechaCorta, porcentaje, type Idioma } from '../../../i18n';
import { aRevisar, ahorroActivo, ordenar, textoSobre, type Cadena, type Meta, type Producto } from '../../../lib/datos';
import { dias, type Historial } from '../../../lib/historial';
import { leerDatos } from '../../../lib/contrato';

export function getStaticPaths() {
  return IDIOMAS.map((lang) => ({ params: { lang } }));
}

const idioma = Astro.params.lang as Idioma;
const dic = textos(idioma);
const base = import.meta.env.BASE_URL;
const meta = leerDatos<Meta>('meta.json');
const indice = leerDatos<{ productos: Producto[] }>('index.json');
const ids = meta.cadenas.map((c) => c.id);

const productos = ordenar(indice.productos, 'ahorro', ids, idioma === 'es' ? 'es-PE' : 'en-US')
  .filter((p) => !aRevisar(p, ids) && (ahorroActivo(p, ids)?.soles ?? 0) > 0)
  .slice(0, 24);

// Sparkline: serie del precio mínimo entre cadenas, con escalón (el precio se mantiene hasta
// la siguiente captura), igual que el gráfico de la ficha. Sin JS.
const W = 120;
const H = 28;
const PAD = 3;
interface Spark { d: string; x: number; y: number; desde: string; hasta: string; n: number }
function spark(slug: string): Spark | null {
  let h: Historial;
  try {
    h = leerDatos<Historial>(`hist/${slug}.json`);
  } catch {
    return null;
  }
  const pts = h.serie
    .map((s) => ({ f: s.fecha, v: Math.min(...ids.map((c) => s.precios[c]).filter((v): v is number => v != null)) }))
    .filter((p) => Number.isFinite(p.v));
  if (pts.length < 2) return null;
  const t0 = Date.parse(pts[0].f);
  const t1 = Date.parse(pts[pts.length - 1].f);
  const lo = Math.min(...pts.map((p) => p.v));
  const hi = Math.max(...pts.map((p) => p.v));
  const x = (f: string) => PAD + (t1 === t0 ? 0 : ((Date.parse(f) - t0) / (t1 - t0)) * (W - 2 * PAD));
  const y = (v: number) => (hi === lo ? H / 2 : PAD + (1 - (v - lo) / (hi - lo)) * (H - 2 * PAD));
  const d = pts
    .map((p, i) => (i === 0 ? `M${x(p.f).toFixed(1)},${y(p.v).toFixed(1)}` : `H${x(p.f).toFixed(1)}V${y(p.v).toFixed(1)}`))
    .join('');
  const ult = pts[pts.length - 1];
  return { d, x: x(ult.f), y: y(ult.v), desde: pts[0].f, hasta: ult.f, n: dias(pts[0].f, ult.f) };
}

const ALTO = 18;
const logo = (c: Cadena) => ({
  estilo: `height:${ALTO}px;background:${c.logo_fondo ?? '#ffffff'}`,
  h: ALTO - 6,
  w: Math.round((ALTO - 6) * Math.min(c.logo_ratio ?? 4, 5)),
});
---

<Lab idioma={idioma} titulo={t(dic, 'lab.nav.c')}>
  <main class="lab-main">
    <section class="hero">
      <h1>{t(dic, 'lab.c.titulo')}</h1>
      <p>{t(dic, 'lab.c.lead')}</p>
    </section>

    <div class="tabla-caja" tabindex="0" role="region" aria-label={t(dic, 'lab.c.titulo')}>
      <table>
        <thead>
          <tr>
            <th scope="col" class="izq">{t(dic, 'lab.c.col.producto')}</th>
            {meta.cadenas.map((c) => (
              <th scope="col" class="der">
                {c.logo
                  ? <span class="logo" style={logo(c).estilo}><img src={`${base}logos/${c.logo}`} alt={c.nombre} height={logo(c).h} width={logo(c).w} /></span>
                  : <span class="logo-mono" style={`width:${ALTO}px;height:${ALTO}px;background:${c.color ?? '#5a626c'};color:${textoSobre(c.color)}`}>{c.nombre.charAt(0)}</span>}
              </th>
            ))}
            <th scope="col" class="der">{t(dic, 'lab.c.col.ahorro')}</th>
            <th scope="col" class="izq">{t(dic, 'lab.c.col.historial')}</th>
          </tr>
        </thead>
        <tbody>
          {productos.map((p) => {
            const ah = ahorroActivo(p, ids)!;
            const s = spark(p.slug);
            return (
              <tr>
                <th scope="row" class="izq prod">
                  <span class="nombre">{p.nombre}</span>
                  <span class="pres">{p.pres}</span>
                </th>
                {meta.cadenas.map((c) => {
                  const v = p.precios[c.id];
                  const min = v != null && ah.en.includes(c.id);
                  return (
                    <td class={`der mono ${min ? 'min' : ''}`}>
                      {v != null ? soles(idioma, v) : t(dic, 'lab.sinPrecio')}
                      {min && <span class="sr-only"> · {t(dic, 'lab.masBarato')}</span>}
                    </td>
                  );
                })}
                <td class="der mono ahorro">
                  <span class="badge">{soles(idioma, ah.soles)}</span>
                  {ah.pct != null && <span class="pct">−{porcentaje(idioma, ah.pct)}</span>}
                </td>
                <td class="izq">
                  {s ? (
                    <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img"
                      aria-label={t(dic, 'lab.c.historial.aria', { producto: p.nombre, desde: fechaCorta(idioma, s.desde), hasta: fechaCorta(idioma, s.hasta) })}>
                      <path d={s.d} fill="none" stroke="rgb(var(--muted))" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path>
                      <circle cx={s.x} cy={s.y} r="3" fill="rgb(var(--saving))"></circle>
                    </svg>
                  ) : (
                    <span class="sin">{t(dic, 'lab.c.sinHistorial')}</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </main>
</Lab>

<style>
  .hero { padding: var(--sp-8) 0 var(--sp-4); }
  h1 { margin: 0; font-size: var(--text-xl); line-height: var(--leading-snug); font-weight: var(--weight-semibold); }
  .hero p { margin: var(--sp-1) 0 0; font-size: var(--text-sm); color: rgb(var(--muted)); }
  .tabla-caja { overflow-x: auto; border: 1px solid rgb(var(--border)); border-radius: var(--radius-md); background: rgb(var(--surface)); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 52rem; }
  thead th {
    position: sticky; top: 0;
    padding: var(--sp-2) var(--sp-3);
    background: rgb(var(--surface));
    border-bottom: 1px solid rgb(var(--border));
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide); text-transform: uppercase; color: rgb(var(--muted));
  }
  tbody tr { border-bottom: 1px solid rgb(var(--border) / 0.6); transition: background var(--dur-fast) var(--ease-out); }
  tbody tr:last-child { border-bottom: 0; }
  tbody tr:hover { background: rgb(var(--fg) / 0.04); }
  td, tbody th { padding: var(--sp-1) var(--sp-3); font-weight: var(--weight-regular); vertical-align: middle; }
  .izq { text-align: left; }
  .der { text-align: right; }
  .prod { max-width: 22rem; }
  .nombre { display: block; font-weight: var(--weight-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pres { display: block; font-size: var(--text-xs); color: rgb(var(--muted)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  td.mono { color: rgb(var(--muted)); }
  td.min { color: rgb(var(--saving)); font-weight: var(--weight-bold); background: rgb(var(--saving) / 0.12); }
  .ahorro { white-space: nowrap; }
  .pct { margin-left: var(--sp-2); font-size: var(--text-xs); color: rgb(var(--muted)); }
  .sin { font-size: var(--text-xs); color: rgb(var(--muted)); }
  svg { display: block; }
</style>
