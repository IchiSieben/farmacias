---
// Metodología (brief §5.4): texto estático bilingüe, 0 JS.
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import { IDIOMAS, textos, t, type Idioma } from '../../i18n';
import { METODOLOGIA } from '../../i18n/metodologia';
import type { Meta } from '../../lib/datos';
import { leerDatos } from '../../lib/contrato';

export function getStaticPaths() {
  return IDIOMAS.map((lang) => ({ params: { lang } }));
}

const idioma = Astro.params.lang as Idioma;
const dic = textos(idioma);
const meta = leerDatos<Meta>('meta.json');
const secciones = METODOLOGIA[idioma];
---

<Base idioma={idioma} titulo={t(dic, 'metodologia.titulo')} descripcion={t(dic, 'metodologia.descripcion')}>
  <Cabecera idioma={idioma} snapshot={meta.snapshot} actual="metodologia" />
  <main class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-semibold tracking-tight">{t(dic, 'metodologia.titulo')}</h1>
    <p class="mt-2 text-suave">{t(dic, 'metodologia.descripcion')}</p>
    <nav aria-label={t(dic, 'metodologia.indice')} class="mt-6 rounded-lg border border-borde bg-superficie p-4">
      <p class="text-sm font-medium">{t(dic, 'metodologia.indice')}</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm">
        {secciones.map((s) => <li><a class="underline underline-offset-2" href={`#${s.id}`}>{s.titulo}</a></li>)}
      </ol>
    </nav>
    {secciones.map((s) => (
      <section id={s.id} class="mt-10 scroll-mt-4">
        <h2 class="text-lg font-semibold tracking-tight">{s.titulo}</h2>
        {s.parrafos.map((p) => <p class="mt-3 leading-relaxed">{p}</p>)}
        {s.lista && (
          <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">
            {s.lista.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </section>
    ))}
  </main>
  <Pie idioma={idioma} />
</Base>
