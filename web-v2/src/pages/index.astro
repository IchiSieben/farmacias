---
// Raíz /radar-precios/: redirige a /es/ o /en/ según la elección guardada o el
// idioma del navegador. Sin JS, enlaces visibles a ambos idiomas.
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Radar de Precios · Price Radar</title>
    <link rel="canonical" href={`${Astro.site}${base.slice(1)}es/`} />
    <script is:inline define:vars={{ base }}>
      var guardado = null;
      try { guardado = localStorage.getItem('idioma'); } catch (e) {}
      var idioma = guardado || ((navigator.language || 'es').toLowerCase().startsWith('es') ? 'es' : 'en');
      location.replace(base + (idioma === 'en' ? 'en' : 'es') + '/' + location.search);
    </script>
  </head>
  <body>
    <p><a href={`${base}es/`}>Español</a> · <a href={`${base}en/`}>English</a></p>
  </body>
</html>
